# Playback start is scheduled to sub-millisecond precision; the default 100 Hz
# tick makes vTaskDelay granularity 10 ms.
CONFIG_FREERTOS_HZ=1000

# The socket's receive queue, in datagrams. The IDF default is 6, and the boot
# banner prints it as `udp mbox: 6`.
#
# One socket carries everything the hub sends this unit: ~49 audio packets a
# second, ~86 analysis frames, four probe replies, and metadata -- about 136
# datagrams a second through a queue six deep. That is 44 ms of headroom, and
# whatever lwIP cannot hand over in 44 ms it discards silently. On this unit the
# only thing draining it is rx_task, which also decodes SBC.
#
# 44 ms is less than the jitter this link produces on a good day and far less
# than a retry burst, and a datagram lost here is indistinguishable in the log
# from one lost on the air: both arrive as a sequence gap. So the counter that
# was being read as radio loss could not have told the difference.
#
# 32 is ~235 ms, which covers the ring's own target depth. It costs a pointer
# each plus the packet buffers the queue holds, against 118 kB free.
CONFIG_LWIP_UDP_RECVMBOX_SIZE=32

# 50% overlap between analysis windows. The window stays 1024; this is only how
# far the analysis advances between them, so it doubles the frame rate to 86 Hz
# without changing the FFT's resolution.
#
# Stated here as well as being the Kconfig default because it is the hop the
# detector is tuned at. Both flux floors and the beat history were swept against
# 206 recordings at 512 and none of the three moved, so a floor running this is
# running the tuned detector -- see docs/tuning-corpus.md. Kept in the tracked
# config rather than left to the component default because a hop mismatch across
# a floor is the expensive bug, and this is the unit it is most likely to happen
# on: nothing crosses between locally analysing units, so a satellite on the
# wrong hop cannot be detected from either console except by reading the hop the
# HEALTH line prints.
CONFIG_DANCEFLOOR_LED_HOP_512=y

# The pattern the floor runs, which is a floor-wide agreement and not a per-unit
# preference: two units on different patterns are not comparable by eye, and the
# eye is the only instrument most of this project has.
#
# Pinned here for the same reason the hop above is, and it matters most on this
# unit for the same reason too -- a floor is mostly satellites, so this is the
# file most copies of the wrong pattern would come from. The Kconfig default is
# "pulse"; this floor runs "boom"; sdkconfig is gitignored, so this line is the
# only place the floor's choice survives a fresh checkout. It did not survive
# one: hub_s3 was built without it and came up cycling a 28-second hue against
# its neighbours' fixed amber, which reads as a sync fault rather than as a
# config difference.
CONFIG_DANCEFLOOR_LED_PATTERN="boom"

# Where this unit's frames and analyser results come from: the hub, not itself.
#
# THIS IS A MEMORY DECISION before it is anything else, and it is pinned here
# because the satellite did not fit without it. A satellite analysing locally
# holds the 80 kB audio ring, a ~33 kB analysis stream, and -- with the slow lane
# local as well -- a further ~13 kB buffer and two more task stacks. On a classic
# ESP32 that does not fit, and the way it does not fit is silent:
#
#   E ALLOCATION FAILED 177 time(s): largest request 4096 B (caps 0x804 INTERNAL)
#   W HEALTH: up 5 s | heap 396 (min 92, window 396, largest 208) | stack play 0
#
# 396 bytes free. The 4096-byte requests are task stacks: probe, rx and play all
# failed to start and only drift fitted, at 3072. `stack play 0` is the play
# task's high-water mark never having been written, because the task does not
# exist. A unit in that state still associates, still takes a DHCP lease, still
# looks healthy from the hub -- and produces no audio, no LEDs and no anchors.
# It reads exactly like a satellite waiting for a stream that never came, which
# is how it was read for an evening. The Kconfig help for ML_SOURCE_LOCAL had
# already priced it: "about 25 kB ... against the ~52 kB a satellite has free
# while analysing." That margin was spent.
#
# REMOTE costs the floor nothing it can see. Frames are drawn at the instant they
# name, so a unit given them stays in step with the unit that made them -- more
# tightly than two units analysing separately, because there is only one copy of
# the decision. The hub already runs both analyses locally and publishes them
# (MSG_FRAME, MSG_ML). The only thing that does not travel is Frame::mag, and no
# pattern can use it anyway: it is gone before a queued frame is drawn, which
# analysis.hpp says outright.
#
# The second line is implied by the first -- ML_SOURCE_LOCAL depends on
# LED_SOURCE_LOCAL, so choosing remote frames leaves remote results as the only
# option -- and is written out because a config that states its intent is worth
# one redundant line.
#
# Floor-wide agreements, like the pattern and hop above: a unit analysing locally
# may run a different algorithm, so what is guaranteed is only that units taking
# frames from the same source render identically. The live source is printed at
# startup and carried on the HEALTH line, so an unintended mismatch is visible.
CONFIG_DANCEFLOOR_LED_SOURCE_REMOTE=y
CONFIG_DANCEFLOOR_ML_SOURCE_REMOTE=y

# The LED sync marker, on by default on this unit.
#
# One flash per master-clock second, on every unit at the same instant: put two
# boards side by side and a floor that agrees is visible with no console and no
# wiring. The Kconfig default is n because it is a bench instrument; a floor made
# mostly of satellites is exactly where it earns its keep, so it is pinned on
# here rather than set by hand on each board and lost with the next sdkconfig.
#
# Nothing corrects on it -- it is an indicator, not a feedback path.
#
# GPIO and polarity are not repeated here: the Kconfig defaults are already
# GPIO 2 and active-low, which is what the boards on this floor are. If the log
# says the marker fired and the LED stays dark, DANCEFLOOR_LED_MARKER_GPIO is the
# setting to change -- the onboard LED pin varies by board.
CONFIG_DANCEFLOOR_ENABLE_LED_MARKER=y

# Forward this unit's logs and HEALTH snapshots over the sync socket to a
# laptop collector (see CONFIG_DANCEFLOOR_WIFI_LOGS). Bench only -- off in a
# production flash, where the shipper compiles out entirely. Each satellite
# ships to the hub, which relays to the collector.
CONFIG_DANCEFLOOR_WIFI_LOGS=y
