# Playback start is scheduled to sub-millisecond precision; the default 100 Hz
# tick makes vTaskDelay granularity 10 ms.
CONFIG_FREERTOS_HZ=1000

# 240 MHz, not the 160 MHz IDF default.
#
# Carried over from the S3 hub, where it was half of a change that cut analysis
# cost in half. Both parts support 240; 160
# is simply the default nobody changed, and this unit had never changed it
# either. It was listed there as "portable, the classic hub could have this
# today" and the classic hub is gone, so the satellite is now the only classic
# ESP32 left in the project and the only place that item can still be claimed.
#
# Costs power and heat, and shifts timing across every task. On a unit that
# analyses locally the win is the analysis; on one taking remote frames (as this
# floor's satellites do) it is headroom in rx_task, which is the task that must
# drain the UDP mailbox and decode SBC without falling behind.
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y

# Flash in QIO at 80 MHz, up from DIO at 40 MHz -- 4x the bandwidth on both axes
# combined. The application is mapped from flash and pulled through the
# instruction cache a line at a time, so this sets what every cache miss
# costs.
#
# THREE TRAPS, all of which have caught someone already:
#
#   1. `idf.py flash` prints `--flash-mode dio` even with QIO selected. That is
#      correct -- IDF stamps the image header DIO so the ROM can read it, and the
#      second-stage bootloader raises the flash to quad during init. Do not
#      "fix" it.
#   2. It must be a full `idf.py flash`, never `app-flash`. The bootloader
#      performs the upgrade, so a stale bootloader leaves the app in DIO.
#   3. Whether a board tolerates this depends on its flash part and wiring. QIO
#      repurposes the WP and HOLD pins (IO2, IO3) as data lines.
#
# If a board will not boot: hold BOOT, tap RESET for ROM download mode, set
# CONFIG_ESPTOOLPY_FLASHMODE_DIO back, reflash. The ROM downloader is in silicon
# and cannot be lost, so this is recoverable on every board.
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y

# HT20 is NOT set here, and that is deliberate.
#
# gap-list S1.3 records forcing HT20 as the single biggest radio win of the S3
# session -- tx-fail from 1016 to roughly 400 -- but that call is
# esp_wifi_set_bandwidth(WIFI_IF_AP, ...) on the HUB, and hub_s3 already makes
# it (streamer.c). A station follows the BSS it joins, so every satellite is
# already on HT20 and there is nothing here to claim. Setting it station-side
# would be a no-op that reads like a second, independent fix.

# The socket's receive queue, in datagrams. The IDF default is 6, and the boot
# banner prints it as `udp mbox: 6`.
#
# One socket carries everything the hub sends this unit: ~49 audio packets a
# second, ~86 analysis frames, four probe replies, and metadata -- about 136
# datagrams a second through a queue six deep. That is 44 ms of headroom, and
# whatever lwIP cannot hand over in 44 ms it discards silently. On this unit the
# only thing draining it is rx_task, which also decodes SBC.
#
# 44 ms is less than the jitter this link produces on a good day and far less
# than a retry burst, and a datagram lost here is indistinguishable in the log
# from one lost on the air: both arrive as a sequence gap. So the counter that
# was being read as radio loss could not have told the difference.
#
# 32 is ~235 ms, which covers the ring's own target depth. It costs a pointer
# each plus the packet buffers the queue holds, against 118 kB free.
CONFIG_LWIP_UDP_RECVMBOX_SIZE=32

# 50% overlap between analysis windows. The window stays 1024; this is only how
# far the analysis advances between them, so it doubles the frame rate to 86 Hz
# without changing the FFT's resolution.
#
# Stated here as well as being the Kconfig default because it is the hop the
# detector is tuned at. Both flux floors and the beat history were swept against
# 206 recordings at 512 and none of the three moved, so a floor running this is
# running the tuned detector; tools/tuning/ has the sweep. Kept in the tracked
# config rather than left to the component default because a hop mismatch across
# a floor is the expensive bug, and this is the unit it is most likely to happen
# on: nothing crosses between locally analysing units, so a satellite on the
# wrong hop cannot be detected from either console except by reading the hop the
# HEALTH line prints.
CONFIG_DANCEFLOOR_LED_HOP_512=y

# The pattern the floor runs, which is a floor-wide agreement and not a per-unit
# preference: two units on different patterns are not comparable by eye, and the
# eye is the only instrument most of this project has.
#
# Pinned here for the same reason the hop above is, and it matters most on this
# unit for the same reason too -- a floor is mostly satellites, so this is the
# file most copies of the wrong pattern would come from. The Kconfig default is
# "pulse"; this floor runs "boom"; sdkconfig is gitignored, so this line is the
# only place the floor's choice survives a fresh checkout. It did not survive
# one: hub_s3 was built without it and came up cycling a 28-second hue against
# its neighbours' fixed amber, which reads as a sync fault rather than as a
# config difference.
CONFIG_DANCEFLOOR_LED_PATTERN="boom"

# WHERE THIS UNIT'S FRAMES COME FROM IS NOW PER-TARGET, and so it is not set
# here. See sdkconfig.defaults.esp32 (REMOTE, and why) and
# sdkconfig.defaults.esp32s3 (LOCAL, and why).
#
# It lived in this shared file while both targets agreed. They no longer do: the
# S3 has PSRAM for the analysis stream and wants its own spectrum for the ML
# analysers, and the classic ESP32 has neither and does not. Leaving a `choice`
# member set here and overridden there would work by file ordering, which is a
# thin thing to rest a floor-wide behaviour on -- so each target states its own.
#
# THE HOP AND THE PATTERN ABOVE STAY SHARED, and deliberately. They are the two
# settings that must not differ across the floor: a locally-analysing S3 and a
# frame-taking classic exchange nothing that would reveal a mismatch, so the
# only instrument is reading `hop` off two consoles. Keeping them in the file
# both targets read is what makes a mismatch require an edit rather than an
# omission.


# The LED sync marker, on by default on this unit.
#
# One flash per master-clock second, on every unit at the same instant: put two
# boards side by side and a floor that agrees is visible with no console and no
# wiring. The Kconfig default is n because it is a bench instrument; a floor made
# mostly of satellites is exactly where it earns its keep, so it is pinned on
# here rather than set by hand on each board and lost with the next sdkconfig.
#
# Nothing corrects on it -- it is an indicator, not a feedback path.
#
# GPIO and polarity are not repeated here: the Kconfig defaults are already
# GPIO 2 and active-low, which is what the boards on this floor are. If the log
# says the marker fired and the LED stays dark, DANCEFLOOR_LED_MARKER_GPIO is the
# setting to change -- the onboard LED pin varies by board.
CONFIG_DANCEFLOOR_ENABLE_LED_MARKER=y

# Forward this unit's logs and HEALTH snapshots over the sync socket to a
# laptop collector (see CONFIG_DANCEFLOOR_WIFI_LOGS). Bench only, and now OFF by
# default -- which is what the line above always said and what this setting
# contradicted. The Kconfig default is n; this file was the only thing turning
# it on here.
#
# The reason is sharper on this unit than on the hub. The shipper is already
# built to be safe -- a low-priority task behind a drop-on-full queue, precisely
# because a blocking log write in rx_task starves the UDP mailbox and causes the
# very loss it was logging -- but safe is not free: the datagrams still go out
# over the radio the audio arrives on, and they are burstiest exactly when
# something has gone wrong.
#
# Must agree with the hub's setting for centralised capture to work at all: this
# unit ships to the hub and the hub relays. Turn both on together for a run
# where that is worth the airtime; otherwise this unit's log is on its own
# serial port.
CONFIG_DANCEFLOOR_WIFI_LOGS=n
