menu "Dancefloor satellite"

    config DANCEFLOOR_I2S_LRCK_PIN
        int "I2S LRCK (WS) GPIO"
        default 27

    config DANCEFLOOR_I2S_BCK_PIN
        int "I2S BCK GPIO"
        default 26

    config DANCEFLOOR_I2S_DATA_PIN
        int "I2S DATA GPIO"
        default 25

    config DANCEFLOOR_MARKER_GPIO
        int "GPIO pulsed when playback crosses a marker instant"
        default 4
        help
            Wire this to the hub's monitor GPIO, plus a common ground, and the
            hub reports how far this unit's audio is from its own. That is the
            end-to-end sync error, measured on the audio rather than inferred
            from clock estimates.

    config DANCEFLOOR_USE_INTERNAL_DAC
        bool "Play through the ESP32's built-in 8-bit DACs (no hardware needed)"
        default n
        help
            Outputs on GPIO 25 (left) and GPIO 26 (right) using the two DACs
            built into the ESP32, instead of I2S to an external chip.

            8-bit and noisy -- nothing like the PCM5102A -- but it needs no parts
            beyond a resistor and a cheap speaker, and it answers the questions
            that matter before a real DAC arrives: does audio come out, is it the
            right speed, and is it in sync with the hub?

    config DANCEFLOOR_AP_OPEN
        bool "Hub SoftAP has no password (must match the hub)"
        default n

endmenu
