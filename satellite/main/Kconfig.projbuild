menu "Dancefloor satellite"

    # Pin defaults per target, so `idf.py set-target esp32s3` produces a
    # buildable unit without anyone remembering an override. The S3 numbers are
    # the XIAO ESP32-S3's D8/D9/D10 and match what hub_s3 already runs, so a
    # satellite and a hub on that board are wired the same way. The classic
    # numbers are this floor's existing boards and have not moved.
    #
    # GPIO 25/26/27 do not exist as usable pins on an S3: 26-32 are taken by the
    # SPI flash and PSRAM on the modules used here, which is why this cannot be
    # one number with a note.

    config DANCEFLOOR_I2S_LRCK_PIN
        int "I2S LRCK (WS) GPIO"
        default 8 if IDF_TARGET_ESP32S3
        default 27

    config DANCEFLOOR_I2S_BCK_PIN
        int "I2S BCK GPIO"
        default 7 if IDF_TARGET_ESP32S3
        default 26

    config DANCEFLOOR_I2S_DATA_PIN
        int "I2S DATA GPIO"
        default 9 if IDF_TARGET_ESP32S3
        default 25

    config DANCEFLOOR_RING_KB
        int "Playback ring buffer (kB)"
        default 96
        range 32 512
        help
            How much decoded audio this unit will hold between arrival and the
            speaker. It must cover the hub's lead time plus headroom for
            delivery jitter -- LEAD_US + RESYNC_US -- which is how far the hub's
            timeline can legitimately be from real time when a chunk is stamped.

            96 kB is 557 ms at 44.1 kHz stereo. It was 80 (464 ms), and it moved
            because the hub's LEAD_US moved 250 -> 350: RING_TARGET_MS tracks the
            lead, the servo's depth net swings it +-120 ms either way, and
            350 + 120 = 470 ms does not fit 464. An 80 kB ring would have dropped
            audio on ring-full in ordinary running.

            96 leaves 87 ms above that excursion and 207 ms above the target --
            the same headroom the old 250 ms / 80 kB pairing had.

            STILL A CLASSIC-ESP32 CONSTRAINT. That board has ~117 kB free with a
            largest block of 106 kB, so 96 fits with 10 kB to spare and 107 (what
            a 500 ms lead would need) will not allocate at all. This is the first
            change to suspect if a classic satellite stops booting, and the
            symptom would be the ring allocation failing outright rather than
            anything subtle.

            THAT CEILING IS THE CLASSIC PART'S, NOT THE PROTOCOL'S. An S3
            satellite has 512 kB of internal SRAM and can afford considerably
            more, which is what would let the hub's lead grow further -- the
            buffer a lead has to fit in is on the receiving board.

            Kept equal on both targets deliberately. Raising it on one unit and
            not another changes only that unit's tolerance for a delivery
            stall, not its sync, but a floor whose units differ is harder to
            reason about than one that does not.

    # Which channels this unit plays lives in components/dancefloor_sync/Kconfig,
    # under "Dancefloor audio output" -- audio_out.h is what reads it, and a
    # shared header must not depend on each project remembering to declare the
    # symbols it consumes. It was declared here and in hub_s3 separately, and the
    # retired classic hub declared it nowhere and silently played stereo.

    config DANCEFLOOR_ENABLE_MARKER
        bool "Sync marker GPIO (bench instrument)"
        default n
        help
            Pulses a pin when playback reaches a tagged sample, so a hub wired
            to it can report how far apart the two units' AUDIO actually is --
            measured at the speaker rather than inferred from clock estimates,
            which makes it the only measurement that sees what happens between
            samples_played and the sound.

            It needs a wire and a common ground to the hub, so a deployed
            satellite cannot have it: it reaches the hub over WiFi and nothing
            else. Off by default for that reason.

            Nothing corrects on it. Every servo and every splice closes through
            play_at and the phase queue, so this changes no behaviour -- only
            whether the measurement exists.

            Costs a 200 us busy-wait in the playback task every ~2 s while on,
            which buys nothing once the wire is off. Track-boundary divergence
            is reported to the hub over WiFi regardless.

    config DANCEFLOOR_MARKER_GPIO
        int "GPIO pulsed when playback crosses a marker instant"
        default 4
        depends on DANCEFLOOR_ENABLE_MARKER
        help
            Wire this to the hub's monitor GPIO, plus a common ground, and the
            hub reports how far this unit's audio is from its own. That is the
            end-to-end sync error, measured on the audio rather than inferred
            from clock estimates.

    # The SSID, the password, DANCEFLOOR_AP_OPEN and DANCEFLOOR_DISABLE_PMF live
    # in components/dancefloor_sync/Kconfig, under "Dancefloor radio pairing".
    # They describe one link seen from both ends and were previously declared
    # here and in the hub independently -- this file's AP_OPEN prompt said "must
    # match the hub" and nothing enforced it.

    config DANCEFLOOR_RETUNE_BENCH_S
        int "Bench only: force a same-rate retune every N seconds (0 = off)"
        default 0
        help
            Retunes the output clock to the rate it is ALREADY set to, on a
            timer. That is a no-op as far as the audio is concerned, so anything
            it costs in sync is the cost of retuning itself -- the channel being
            down, and the DMA buffer being discarded -- with no rate change and
            no drift confusing the measurement.

            Four retunes scraped from an ordinary session put the phase step at
            somewhere between 5 and 22 ms, which is not a number. This turns it
            into one.

            Enable it on ONE unit only and watch the hub's AUDIO SYNC line: the
            marker fires when a sample physically reaches the output, so it sees
            the discarded DMA buffer, which no measurement inside the firmware
            can. Leave at 0 for anything you intend to listen to.

endmenu
