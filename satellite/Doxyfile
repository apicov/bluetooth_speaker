# Doxygen configuration for the satellite firmware.
#
# Run from this directory:  doxygen Doxyfile
#
# The point of the settings below is that the run is a CHECK, not just a
# renderer. EXTRACT_ALL is off and WARN_IF_UNDOCUMENTED is on, so anything
# declared and left undocumented is a warning rather than a silently empty
# page; WARN_IF_DOC_ERROR catches an @param naming a parameter that does not
# exist. A clean warning log is the coverage test.

PROJECT_NAME           = "Dancefloor satellite"
PROJECT_BRIEF          = "Joins the hub's SoftAP, plays the stream in time with it, drives a strip"
OUTPUT_DIRECTORY       = doc-gen
OUTPUT_LANGUAGE        = English

INPUT                  = main
FILE_PATTERNS          = *.c *.h
RECURSIVE              = NO
EXCLUDE_PATTERNS       = */build*/* */managed_components/*

# Most of this firmware is static: 24 of rx.c's 26 functions, and 31
# file-scope objects across the tree. Without this, most of it is invisible.
EXTRACT_STATIC         = YES
EXTRACT_ALL            = NO
EXTRACT_PRIVATE        = NO
EXTRACT_LOCAL_CLASSES  = NO

OPTIMIZE_OUTPUT_FOR_C  = YES
TYPEDEF_HIDES_STRUCT   = YES
JAVADOC_AUTOBRIEF      = NO
ALWAYS_DETAILED_SEC    = NO
REPEAT_BRIEF           = NO

WARN_IF_UNDOCUMENTED   = YES
WARN_IF_DOC_ERROR      = YES
WARN_NO_PARAMDOC       = YES
WARN_LOGFILE           = doc-gen/doxygen.warn
QUIET                  = YES

# Without these Doxygen skips every #if-guarded block: the FEC layer (~400
# lines of rx.c), the visualiser paths, and the marker code. The values are
# the Kconfig defaults; they decide what is DOCUMENTED, not what is built.
ENABLE_PREPROCESSING   = YES
MACRO_EXPANSION        = YES
EXPAND_ONLY_PREDEF     = NO
SEARCH_INCLUDES        = NO
PREDEFINED             = CONFIG_DANCEFLOOR_AUDIO_FEC_K=4 \
                         CONFIG_DANCEFLOOR_ENABLE_VISUALISER=1 \
                         CONFIG_DANCEFLOOR_ENABLE_MARKER=1 \
                         CONFIG_DANCEFLOOR_WIFI_LOGS=1 \
                         CONFIG_DANCEFLOOR_RETUNE_BENCH_S=0 \
                         CONFIG_DANCEFLOOR_LOG_PERIOD_S=20 \
                         CONFIG_DANCEFLOOR_RING_KB=96 \
                         IRAM_ATTR= \
                         __attribute__(x)=

GENERATE_HTML          = YES
GENERATE_LATEX         = NO
GENERATE_TREEVIEW      = YES
HTML_OUTPUT            = html

SOURCE_BROWSER         = YES
INLINE_SOURCES         = NO
REFERENCED_BY_RELATION = YES
REFERENCES_RELATION    = YES

HAVE_DOT               = NO
