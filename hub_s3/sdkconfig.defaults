CONFIG_IDF_TARGET="esp32s3"

CONFIG_FREERTOS_HZ=1000

# The XIAO ESP32-S3 Plus carries 16 MB of flash, against the classic hub's 4 and
# the plain/Sense XIAO's 8. Nothing here needs it -- the app is far under 8 MB
# and the partition table is SINGLE_APP -- so this line is about the image header
# describing the part it is on rather than about capacity. An 8 MB setting on a
# 16 MB board boots and runs; it just understates the flash and caps anything
# later that wants a bigger app partition.
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y

# QIO, up from the DIO this build inherited from the classic hub.
#
# The application is mapped from flash and pulled through the instruction cache
# a line at a time -- 32 bytes here -- so every cache miss is a burst read whose
# cost is set by how many data lines the flash uses. DIO drives two (IO0, IO1)
# for address and data alike; QIO drives four, adding IO2 and IO3, which on a
# plain part are the WP and HOLD signals and get repurposed as data lines. At
# the 80 MHz this board clocks flash, that is ~20 MB/s against ~40.
#
# It does not reduce how OFTEN the cache misses -- the 32 kB cache setting
# further down does that -- it halves what each miss costs. The two are worth
# having together: fewer misses, and cheaper ones.
#
# Octal is not available here and never will be: it needs eight data lines and
# a module built for them, and CONFIG_ESPTOOLPY_OCT_FLASH is unset because this
# board's flash is quad -- 16 MB of it on the Plus, and still quad. (The 8 MB of
# PSRAM on the XIAO IS octal, which is where GPIO 33-37 go -- see the note at the
# end of this file.) So QIO at 80 MHz STR is this board's ceiling.
#
# DO NOT "FIX" THE `dio` YOU WILL SEE WHEN FLASHING. `idf.py flash` prints
# `--flash-mode dio` and build/flash_args says the same, with this set to QIO.
# That is correct and deliberate -- IDF's own Kconfig says so:
#
#     # Note: we use esptool to flash bootloader in
#     # dio mode for QIO/QOUT, bootloader then upgrades
#     # itself to quad mode during initialisation
#     config ESPTOOLPY_FLASHMODE
#         default "dio" if ESPTOOLPY_FLASHMODE_QIO
#
# The image header has to be readable by the ROM before any of our code runs, so
# it is stamped DIO; the second-stage bootloader raises the flash to quad during
# init. CONFIG_ESPTOOLPY_FLASHMODE_QIO in sdkconfig.h is the setting that is
# actually in force. Reading the flasher output as "it did not apply" and
# reverting this is the obvious wrong move, which is why this paragraph is here.
#
# Flash it with a full `idf.py flash`, not `app-flash`: the bootloader is the
# part that performs the upgrade, so a stale one leaves the app in DIO.
#
# If the board does not come up, the chip is not damaged and the ROM downloader
# is in silicon: hold BOOT, tap RESET to force download mode, set this back to
# DIO and reflash.
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y

# The console is a WIRE, not the USB connector, and that is the whole point.
#
# This board has no USB-UART bridge: the S3's USB peripheral is wired straight to
# the connector, so the obvious console is ESP_CONSOLE_USB_SERIAL_JTAG and that
# is what this build used to be. The cost of that only became visible late.
#
# SOC_WIFI_PHY_NEEDS_USB_WORKAROUND is set on this part -- the USB and WiFi PHYs
# interfere -- and IDF's fix is blunt: on affected targets the PHY library
# DISABLES the USB PHY when WiFi initialises, to get best WiFi performance.
# ESP_PHY_ENABLE_USB overrides that fix and keeps USB powered, and it defaults to
# y whenever the console is USB Serial/JTAG. components/esp_phy/Kconfig says what
# that costs in plain words: "the USB PHY can interfere with WiFi thus lowering
# WiFi performance ... this option can be disabled to increase WiFi performance".
#
# So a USB console means running this unit's radio with IDF's own mitigation
# switched off, permanently, on the one board in this project whose measured
# problem was the transmit path. The classic hub never had the question: its
# console goes through a separate bridge chip and its radio never sees USB.
#
# UART0 TX on GPIO 43 -- pad D6, the one silkscreened TX, and free in the pin map
# below. RX is -1, meaning no pin at all: GPIO 44 is already the SBC link and a
# log needs no input. D2 (GPIO 3) and D5 (GPIO 6) are still spare if a REPL is
# ever wanted. UART0 for the console against UART_NUM_1 for SBC, so the two
# peripherals do not collide either.
#
# 921600 baud, not the 115200 default, because logging is on the critical path in
# this firmware and has already caused one fault on the satellite: an ESP_LOGW
# per lost packet from the receive task, ~5 ms of blocking UART per line at
# 115200, feeding back into more loss. Drop this if an adapter cannot keep up --
# garbage on the console is the only symptom and it costs a rebuild.
#
# SECONDARY_NONE is load-bearing. The ESP_CONSOLE_SECONDARY choice defaults to
# USB_SERIAL_JTAG the moment the primary console is not USB, which would quietly
# pull the USB PHY back in and undo all of the above. So must ESP_PHY_ENABLE_USB
# be set explicitly: its default is `y if IDF_TARGET_ESP32S3` regardless of what
# the console is doing.
#
# WHAT THIS COSTS AT THE BENCH. The USB PHY is down from the moment WiFi starts,
# so the port vanishes a few hundred ms into boot and esptool cannot reset the
# board into download mode by itself. Flashing now means holding BOOT and tapping
# RESET first, every time. Wire the adapter as: adapter RX <- GPIO 43 (D6),
# adapter GND <- board GND. Nothing else.
CONFIG_ESP_CONSOLE_UART_CUSTOM=y
CONFIG_ESP_CONSOLE_UART_NUM=0
CONFIG_ESP_CONSOLE_UART_TX_GPIO=43
CONFIG_ESP_CONSOLE_UART_RX_GPIO=-1
CONFIG_ESP_CONSOLE_UART_BAUDRATE=921600
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y
CONFIG_ESP_PHY_ENABLE_USB=n

# The radio settles back where the classic hub has it, and the record of why is
# worth more than the two lines it takes to say it.
#
# THE FAULT. A satellite joining a playing stream measured 1016 sendto()
# rejections in one 20 s window -- the `tx-fail` figure on the status line --
# with a previous session in the same log peaking at 1653. The satellite saw
# the other side as ~85% packet loss, phase reaching +1.25 s, and eighteen
# re-anchors in three seconds. alloc-fail stayed 0 throughout, so this was never
# the heap: it is the WiFi driver's transmit path refusing work it has not put
# on the air yet. The IDF's own help for ESP_WIFI_DYNAMIC_TX_BUFFER_NUM
# describes it exactly -- "especially UDP applications, the upper layer can
# deliver frames faster than WiFi layer can transmit".
#
# THE WRONG FIX, which was tried and is recorded here because it looked right.
# Turning aggregation on and unpinning the rate removed the storm completely:
# tx-fail went to 152 once and then zero across twelve consecutive windows, and
# the satellite anchored once instead of eighteen times. It also made the
# STEADY STATE worse by more than an order of magnitude. Satellite gaps per
# minute, from the logs:
#
#   6 Mbps pinned, settled ....... 0.33   (1 gap in 180 s)
#   adaptation + AMPDU ........... 3.5 to 14
#
# The reason is margin. 6 Mbps is the most robust OFDM rate there is; rate
# adaptation at rssi -24 climbs to the top of the MCS range, where a brief
# interferer costs frames that 6 Mbps would have survived. A fixed 24 Mbps was
# tried far earlier in this project and measured 23% loss (see the comment on
# esp_wifi_internal_set_fix_rate in main/streamer.c), which is the same effect
# further along.
#
# WHAT WAS ACTUALLY WRONG. tx-fail in the 6 Mbps run decayed to 0 and stayed
# there for the rest of the session. The transmit path was never broken -- it
# was broken for the first minute of a stream, on the step from idle to ~135
# datagrams a second, and 10% airtime does not saturate anything. That is a
# BUFFER COUNT problem, not a rate problem, and it is fixed below where it
# lives rather than by trading away the robustness that was working.
#
# So: aggregation off was the verdict then (esp_wifi_internal_set_fix_rate
# refuses to run with it on), the rate pinned, and the burst absorbed by TX
# buffers. That was the right call for *reliability at small N*. It is now
# RE-OPENED because the goal moved to satellite COUNT: unicast fan-out makes
# downlink airtime scale with N, and at 6 Mbps the duty-cycle wall lands around
# 6-8 satellites (the table below is where that became visible). A-MPDU
# amortises the ~350 us per-frame DIFS/backoff/preamble across a burst and lets
# rate adaptation reach MCS7 (~65 Mbps), buying roughly 10x airtime headroom.
# Aggregation requires the rate unpinned (the constraint above), so the two
# flips below go together; the satellite needs no rebuild -- AMPDU RX is on
# (RX_BA_WIN 6) and it accepted aggregates when this was tried before, the run
# where tx-fail went 1016 -> 0 (see THE WRONG FIX above).
#
# Steady-state cost on the OLD hardware: 0.33 -> 3.5-14 gaps/min (table below).
# That number was taken with a 16 kB I-cache and the USB-PHY mitigation off;
# both have since flipped (32 kB cache below, ESP_PHY_ENABLE_USB=n). Re-measured
# on this hardware: 0 audio gaps/min over 18 min at 1 satellite, tx-fail 0, hub
# min heap ~68 kB -- clears the ~2.5 gaps/min bar that the old number failed, so
# the flip holds. Scaling to more satellites is still unmeasured (the airtime
# model predicts ~30 at light aggregation); the satellite also logged 17 brief
# STA re-associations that the play buffer absorbed without an audio gap.
CONFIG_ESP_WIFI_AMPDU_TX_ENABLED=y
CONFIG_ESP_WIFI_TX_BA_WIN=6

# The rate axis. All four points were measured on this hardware and 6 Mbps was
# the one that held, 0.33 gaps/min; "do not re-open without a new reason" was
# the standing instruction. The new reason is scaling satellite count (see the
# AMPDU block above), so the rate is unpinned to 0 below and the table stands
# as the record on the OLD hardware.
#
#   rate            satellite gaps            note
#   ----            --------------            ----
#   6 Mbps          5 in 245 s (1.2/min)      this line
#   12 Mbps         241 by 125 s (~115/min)   ~50x worse than 6
#   24 Mbps         23% loss                  measured far earlier in the project
#   0 (adaptive)    3.5 to 14/min             plus AMPDU, see the block above
#
# The 12 Mbps run also ran phase to +221 ms and had the visualiser rendering
# 1762 frames late in one window. It was tried on a specific and reasonable
# theory -- that the startup transient is airtime-bound, so halving the air time
# per frame should shorten it -- and that theory is now dead. Whatever the
# transient is, it is not something a faster pinned rate improves, and every
# step away from 6 Mbps costs far more in steady-state margin than it returns.
#
# What remains unfixed, and is NOT a rate problem: 64 TX buffers cut the startup
# transient about fourfold (tx-fail 1016 -> 251, then 78, then zero) but did not
# end it. A satellite joining during what is left can find 203 CONSECUTIVE
# packets already past their play_at, exhaust its five-second anchor window, and
# have to anchor at -64 ms lead -- costing phase +62 ms and seven retunes over
# ~180 s. The satellite side handles that exactly as designed and can do nothing
# better, because there is no anchorable packet to be had.
#
# The next lever for that is buffers against heap, which on this unit is already
# at a 34.7 kB minimum with a 31.7 kB largest block. That is a real constraint,
# not a free knob.
#
# Rate unpinned (0 = adaptation), paired with the AMPDU flip above. The 3.5-14
# gaps/min in the table is the stale number; on this hardware it re-measures at
# 0 gaps/min at 1 satellite (see the AMPDU block), so the flip holds.
CONFIG_DANCEFLOOR_WIFI_PHY_RATE_MBPS=0

# 240 MHz, up from the 160 that IDF defaults to and that this build inherited
# without anyone choosing it.
#
# Set alongside the cache line below because they answer the same question, and
# the question was a good one: why does the S3 hub perform the same as or worse
# than the classic ESP32 it replaced?
#
# The honest accounting, which is worth writing down because the intuition is
# so strongly the other way. Against the classic part the S3 offers: a higher
# maximum clock (was not enabled -- this line), 512 kB of SRAM against 320
# (nothing here asked for it; it went to the heap), PSRAM (deliberately off, and
# correctly -- see the note at the end of this file), an LX7 with SIMD (ACTIVE,
# via esp-dsp, and the one advantage this build was already collecting), a USB
# peripheral (a liability here: SOC_WIFI_PHY_NEEDS_USB_WORKAROUND is set on this
# part and the console runs on it), and the same class of WiFi radio -- 2.4 GHz
# only, b/g/n, single spatial stream, MCS7 ceiling. There was never a radio
# upgrade to collect, which matters because the radio is what looked broken.
#
# One usable advantage, already on. Everything else disabled by default, unused,
# declined on purpose, or nonexistent -- plus one DISADVANTAGE taken by default
# in the cache. "Same or worse" was the expected result, not an anomaly, and the
# fix is to enable the things that were never enabled rather than to keep
# looking for a fault.
#
# Costs power and heat, and it moves timing everywhere. Read analysis mean/max
# on the vis cost line and tx-fail on the status line after changing it.
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y

# 32 KB of instruction cache, and this is the line that should never have needed
# writing. It is the best current candidate for why an S3 hub struggles at a job
# the classic hub has done for months.
#
# The ESP32-S3 can run 16 or 32 kB of I-cache and IDF defaults to 16. The classic
# ESP32 HAS NO SUCH SETTING -- components/esp_system/port/soc/esp32/ contains no
# Kconfig.cache at all, because its cache is fixed. So when this project was
# retargeted, there was nothing in the classic hub's config to inherit: the
# symbol appeared for the first time and silently took IDF's default, and this
# unit has been running half the instruction cache of the one it was copied
# from, ever since.
#
# That is the trap worth remembering, more than the setting. "The configuration
# started the same as the classic ESP32" is TRUE and is exactly the reason: a
# symbol that exists only on the new target cannot be inherited from the old
# one, and no diff of the tracked files will ever show it. It is the same shape
# as the LED pattern note below, which cost a false sync-fault reading.
#
# Why it should matter here specifically: this unit runs the FFT analysis, SBC
# decode, LED rendering and the WiFi driver, all out of flash through that
# cache, and a miss stalls the CPU on a SPI fetch. If those stalls land in the
# transmit path, TX buffers do not drain and sendto() starts refusing -- which
# is the fault. Corroborating evidence already in the logs: this is an LX7 with
# SIMD esp-dsp and should beat the classic hub's LX6 at the FFT, yet it reports
# analysis 3900/21000 us mean/max against an 11.6 ms frame period. A max of
# nearly two frame periods on the FASTER chip is not compute.
#
# Partly offset by flash at 80 MHz here against the classic hub's 40, which
# makes each miss cheaper. Evidently not enough.
#
# Costs 16 kB of heap: the unused half is given to the allocator at 16 kB, and
# is not at 32. Paid for by the line below.
CONFIG_ESP32S3_INSTRUCTION_CACHE_32KB=y

# Back to the IDF default of 32, from 64, and deliberately.
#
# 64 was the right guess when the transient looked like a buffer shortage: it
# cut tx-fail from 1016 to 251, then 78. But it never ended the transient, and
# it costs the heap this unit no longer has spare once the cache above takes its
# 16 kB back -- the minimum was already 34.7 kB with a 31.7 kB largest block.
#
# Returning it also makes the cache change a SINGLE-VARIABLE experiment. 32
# buffers with a 16 kB cache is exactly the configuration that measured tx-fail
# 1016; if 32 buffers with a 32 kB cache measures near zero, the cache was the
# cause and the buffer count never was. If the storm comes back, the cache is
# not the answer and 64 should return.
#
# INERT SINCE SPIRAM_TRY_ALLOCATE_WIFI_LWIP WENT ON, and kept only as the record
# of what this unit was tuned to. esp_wifi/Kconfig makes the DYNAMIC option
# `depends on !(SPIRAM_TRY_ALLOCATE_WIFI_LWIP && !SPIRAM_IGNORE_NOTFOUND)`, so
# enabling PSRAM for WiFi did not merely change where TX buffers come from -- it
# removed the dynamic choice entirely and dropped the build to STATIC, whose
# count is a different symbol with a default of 16. The line below reads as 32
# buffers and delivered 16.
#
# That is the confound the block at SPIRAM_TRY_ALLOCATE_WIFI_LWIP pinned three
# other symbols to avoid. It could not pin this one, because the dependency
# removes the option rather than changing its default -- so the PSRAM experiment
# silently also halved TX capacity, and the "BUFFER COUNT problem" fixed above
# came back with it.
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=32

# The count that is actually in force, and the other half of the LOCAL_RING_BYTES
# change in main/hub.h.
#
# THE FAULT, 2026-08-12: tx-fail returned at 1-148 per 20 s window, ~1% of
# datagrams, and every one of them was ENOMEM -- measured, not inferred, by the
# errno tally tx_fail_note() now keeps. No EHOSTUNREACH at all, which is what
# rules out the ARP path client_joined() exists to protect and leaves buffer
# exhaustion as the whole of it.
#
# WHY NOW. It was hiding behind a bug. A refactor had local_play_task reading the
# ring 4 bytes at a time (sizeof on a pointer parameter), which starved the
# visualiser, which meant publish_frame() and publish_ml() sent NOTHING. Fixing
# the audio restored ~172 datagrams/s of publish traffic on top of ~50 of audio,
# and 16 static buffers does not absorb the bursts at 222/s. The pre-fix logs
# reading tx-fail 0 were measuring a hub with its analysis lane dead.
#
# WAS 26, NOW 32, and the reason 26 was the ceiling has gone away. Each static
# buffer is ~1.6 kB of INTERNAL memory; the pool had 7,760 bytes free, so 32
# would have needed 25.6 kB against the 16 kB freed by taking the ring from
# 64 kB to 48 kB. 26 was what that bought.
#
# The hub then stopped running its ML lane (DANCEFLOOR_ML_SOURCE_REMOTE below)
# and got ~24.9 kB of internal SRAM back -- measured, `MEM: internal` min going
# 6740 -> 22012 with the 26 -> 32 step already paid for out of it. That is what
# 32 is spent from, not the ring, which stays at 48 kB and keeps the feed-burst
# margin hub.h argues for.
#
# 32 WAS MEASURED, over 125 s, and it was enough for the DTIM burst that
# DANCEFLOOR_MCAST_FRAMES creates: the hub read `tx-fail 0 (0 audio)` and the
# satellite `gaps 0`, where 26 gave `tx-fail 14-27 audio` per 20 s window. 40 was
# written here briefly and never reached a board, and the standing instruction
# was not to raise it on the strength of that.
#
# STILL 32, AND 40 IS NOT AVAILABLE. Tried 2026-08-15 and it does not boot:
#
#   assert failed: void visualiser_start() visualiser.cpp:1544 (pcm_stream)
#
# in a reboot loop. The reason is CONTIGUITY, not total free memory, and this is
# the trap worth carrying: pcm_stream is ONE allocation of STREAM_BYTES --
# FFT_N * CHANNELS * 2 * 8 = 32 kB (visualiser.cpp:123) -- and esp_wifi_init()
# takes these buffers out of internal DRAM BEFORE visualiser_start() asks for
# it. Eight more buffers is 12.8 kB off the largest free block, and the block
# stopped being 32 kB.
#
# THE NUMBER THAT MISLED, so nobody re-derives it: the HEALTH line's
# `internal 32604 free (min 30592, largest 22528)` looks like 12.8 kB of room.
# It is not. `min` is a TOTAL and this allocation needs a contiguous block; and
# `largest 22528` is measured AFTER pcm_stream already holds its 32 kB, so it
# describes what is left over, not what was available to it. Neither number can
# see this ceiling. Only a boot can.
#
# So the pool is not the lever here. The next one costs no memory at all: the
# DTIM hold, where 86 group-addressed analysis frames a second each occupy one
# of these buffers until the beacon releases it. See DANCEFLOOR_MCAST_FRAMES.
#
# WHAT ARGUED FOR RAISING IT, kept because the fault is real and still open. A
# 45-minute soak that 125 s could not have shown
# (tools/soak/logs-soak-20260815-224002): tx-fail came back at 1-33 audio
# datagrams per 5 s window in roughly 30 of ~50 windows, and the satellites met
# each burst with a gap fill -- `gaps 14 (586 ms silence)` against
# `tx-fail 47 (33 audio)` in the same window -- which left their rings at
# `buffer 449 ms` and their phase at +268 ms. Both satellites stepped together
# and the hub did not move, which is what says the loss is here and not on the
# air or in a satellite.
#
# READ THE PREMISE THAT CHANGED. Everything above argues buffers over rate on the
# grounds that the transmit path "was broken for the first minute of a stream, on
# the step from idle to ~135 datagrams a second" -- a startup transient, which is
# exactly what a deeper queue absorbs. That premise no longer holds: the failures
# in this soak are spread evenly across all 45 minutes with no startup
# concentration (4 audio at 22:41, 33 at 22:52, 31 at 23:07, 14 at 23:24). A
# deeper queue absorbs a burst; it does not fix a burst that recurs. Even if the
# memory had been there, 40 was only ever expected to REDUCE this rather than end
# it. The bar is `tx-fail 0 (0 audio)` across a whole session.
#
# NOT the dynamic path either. ESP_WIFI_DYNAMIC_TX_BUFFER_NUM above is dead --
# the live sdkconfig has ESP_WIFI_TX_BUFFER_TYPE=0 -- and restoring the option
# means turning SPIRAM_TRY_ALLOCATE_WIFI_LWIP off, which pushes lwIP's buffers
# back into internal SRAM. WiFi TX buffers must be DMA-capable and come from
# internal heap either way, so that trade is likely net-negative here.
#
# 36 WAS MEASURED AND WORKED, and the instrument that measured it said how much
# was left: `analysis stream: 32768 bytes, largest internal block was 36864
# (31744 left)`. 36864 - 32769 is 4095 bytes, so 38 was the ceiling and 39 was
# not -- which is also why 40 boot-looped.
#
# MEMORY IS NO LONGER THE CEILING, and it turned out not to be the limit either.
# pcm_stream is allocated from PSRAM now (visualiser.cpp, MALLOC_CAP_SPIRAM),
# which is the one sanctioned way to move anything off internal on this board --
# SPIRAM_USE_CAPS_ALLOC means plain malloc never returns PSRAM, so a thing moves
# only by asking. That returned the whole 32 kB (measured: `analysis stream:
# 32768 bytes in PSRAM, largest internal block 31744 -> 31744`, and hub
# `internal min 37704` against 30592 before), AND it retired the 32 kB
# CONTIGUOUS requirement that made the earlier overshoot a reboot loop.
#
# 48 WAS THEN TRIED, AND IT IS WORSE THAN 36. This is the finding worth keeping,
# because every step in this file's history moved the number UP -- 16, 26, 32 --
# and nobody had looked for the top. Per hour, three soaks:
#
#   buffers          32        36        48
#   hub windows w/ tx-fail  23%      4.2%     14.7%
#   sat gaps/h              92        16        35
#   anchors-refused/h      139        15       278
#   dma-starve/h           714       113       900
#   ring-full/h             15         0        21
#   pad frames/h         31500      9400     24300
#
# 48 is worse than 32 on several of those. Memory was fine throughout
# (alloc-fail 0, internal min 37704), so this is not a resource fault.
#
# WHY MORE IS WORSE: bufferbloat. These buffers do not increase the rate the
# radio drains them -- group-addressed frames leave on the DTIM beacon and
# nothing here changes that -- so a deeper pool only lets more packets QUEUE, and
# they arrive late instead of not arriving. Audio has a hard deadline: every
# chunk carries play_at, LEAD_US = 200 ms ahead, and a satellite that gets a
# packet after its instant has already filled the gap with silence and moved on.
# A late packet is worth less than a dropped one. `anchors-refused` is the
# counter that says so directly -- it fires when an arriving packet's play_at has
# passed -- and at 48 it is 278/h against 15/h at 36.
#
# So: 36, and the ceiling on this number is BEHAVIOURAL, not memory. Anything
# that raises it again has to answer anchors-refused, not free bytes.
#
# The PSRAM move stays regardless. It costs nothing measurable -- vis
# `cost: analysis 1328/4406 us` against a 1358/4287 baseline, and the hub's own
# audio path reads dma-starve 0, short-reads 0, underruns 0 -- and the headroom
# it buys is what makes the next experiment a free choice rather than a fight
# with the allocator. It is simply not headroom that should be spent here.
#
# CAVEAT ON ATTRIBUTION: the 48 run also carried the PSRAM move, so strictly it
# is 48+PSRAM against 36+internal. The evidence points at the count -- analysis
# cost did not move, the hub's own playback is spotless, and cache jitter would
# have hit that first -- but the clean comparison is 36+PSRAM, which is what this
# build now is.
#
# Falsified by tx-fail itself, which is the counter CACHE_TX_BUFFER_NUM is pinned
# to 0 further down to keep honest.
CONFIG_ESP_WIFI_STATIC_TX_BUFFER_NUM=36

# The socket's receive queue, in datagrams. IDF defaults to 6 and the boot
# banner prints it as `udp mbox: 6`.
#
# Raised on the satellite first, where the case was obvious: one socket taking
# ~136 datagrams a second through a six-deep queue is 44 ms of headroom, and
# whatever lwIP cannot hand over in 44 ms it discards silently.
#
# The hub's case is quieter and slower to see, which is why it was nearly left
# alone. This socket carries only time probes and splice reports -- four probes
# a second per satellite -- so at one satellite six deep is 1.5 s of slack and
# nothing could plausibly overflow it.
#
# It does not stay that way. The rate scales with the floor: at MAX_CLIENTS = 8
# it is 32 datagrams a second and under 200 ms of headroom, from eight units
# free-running on independent 250 ms timers whose probes will sometimes arrive
# together. probe_task serves this socket at priority 6, below playback and the
# sync monitor.
#
# What makes it worth the bytes rather than merely tidy is the FAILURE MODE. A
# probe lost in this queue is indistinguishable from a satellite that stopped
# probing, and CLIENT_TIMEOUT_US is 2 s -- eight probes. Lose enough and the hub
# forgets a satellite that is sitting right there, drops it from the send list,
# and stops sending it audio until its next probe gets through. That is a silent
# speaker, reported as sta-timeout, and no counter anywhere would say the
# difference.
#
# 32 matches the satellite, so there is one number for this on the floor rather
# than two.
CONFIG_LWIP_UDP_RECVMBOX_SIZE=32

# 50% overlap between analysis windows. The window stays 1024; this is only how
# far the analysis advances between them.
#
# Pinned here for the reason it is pinned on the classic hub and on the
# satellite: a hop mismatch across a floor is the expensive bug, and this build
# makes one MORE likely rather than less, because it is the first unit on the
# floor whose config is not a copy of the others'. Both flux floors and the beat
# history were swept against 206 recordings at 512 -- see docs/tuning-corpus.md.
CONFIG_DANCEFLOOR_LED_HOP_512=y

# The pattern the floor runs, which is a floor-wide agreement and not a per-unit
# preference: two units on different patterns are not comparable by eye, and the
# eye is the only instrument most of this project has.
#
# Pinned here for the same reason the hop above is, and this build is the one
# that proved the reason. The Kconfig default is "pulse"; this floor runs
# "boom"; sdkconfig is gitignored, so the "boom" on the classic hub and the
# satellite lived only in untracked files and did not come across. The first S3
# hub therefore came up cycling a 28-second hue against its neighbours' fixed
# amber, and the immediate reading of that was a sync fault.
#
# Cheaper than a hop mismatch, which is invisible -- this one is obvious the
# moment the strips are side by side. It is still worth a tracked line, because
# what it looks like is the expensive thing rather than what it is.
CONFIG_DANCEFLOOR_LED_PATTERN="boom"

# ---------------------------------------------------------------------------
# Pin map: Seeed Studio XIAO ESP32-S3 Plus
# ---------------------------------------------------------------------------
#
# The header breaks out eleven GPIOs, D0-D10, and every number below is one of
# them:
#
#   D0=1  D1=2  D2=3  D3=4  D4=5  D5=6  D6=43(TX)  D7=44(RX)
#   D8=7(SCK)  D9=8(MISO)  D10=9(MOSI)
#
# That map is IDENTICAL on the plain XIAO ESP32-S3, the Sense and the Plus, which
# is why moving this build from a Sense to a Plus changed one line in this file
# (the flash size at the top) and no pin at all. Same ESP32-S3R8, same header.
#
# The hub wants seven of the eleven, so the map below is not one arrangement
# among many -- it is close to the only one. D6 is the console UART TX (see the
# top of this file); what is left over after that is D1, D2 and D5.
#
# None of the classic hub's numbers carry over except the marker. 23 and 25 do
# not exist on this part; 26 and 27 do, but are wired to the SPI flash.
#
# WHAT THE PLUS ADDS, and why nothing below uses it. Beyond the header it brings
# out roughly nine more GPIOs on SMD castellations and rear pads -- D11-D15 =
# GPIO 38-42 are the confirmed ones. They are solder pads, not header pins, so
# they are not free the way a header pin is, and this firmware needs none of
# them. What they DO undo is the "for good" in the D4 paragraph further down: the
# marker/monitor instrument lost GPIO 5 to the SBC link and there is now
# somewhere else for a monitor pin to go, for anyone willing to solder to a pad.
#
# It also drops what the Sense had. No camera, no PDM microphone, no SD slot --
# so the Sense-era warning that the card reader might contend for the D8/D9/D10
# pads used by I2S below is simply gone, and GPIO 41/42 are ordinary pads here
# rather than a microphone's. Nothing is lost with them: a hub analyses the
# synchronised stream and deliberately never listens to a room
# (architecture.md S12), so the Sense's sensors were always dead weight.

# I2S to the PCM5102A, on the three SPI-labelled pads so the DAC is one ribbon
# off the end of the header. This chip is the I2S master.
CONFIG_DANCEFLOOR_I2S_BCK_PIN=7
CONFIG_DANCEFLOOR_I2S_LRCK_PIN=8
CONFIG_DANCEFLOOR_I2S_DATA_PIN=9

# Four wires in from the bridge chip, on SPI3 -- SPI2 is the LED strip.
#
# SCK keeps D7, the pad this link used to arrive on as a UART, so one lead of
# the old wiring survives. The other three take what was left: D5 and D2 were
# genuinely spare, and D4 was not.
#
# D4 = GPIO 5 was DANCEFLOOR_MONITOR_GPIO, and taking it ends the marker/monitor
# instrument on the header, because that needs GPIO 4 AND GPIO 5 and only one of
# them survives out here. Four pads had to come from somewhere and this was the
# cheapest of them: the instrument is off (DANCEFLOOR_ENABLE_MARKER defaults to
# n), it needs a wire between two boards that a deployed floor cannot have, and
# nothing in either firmware corrects on it. TRACK DIVERGENCE over WiFi is
# untouched and covers every satellite rather than the one on the bench.
#
# This said "for good" while the board was a Sense and eleven pads was the whole
# of it. On the Plus a monitor pin could go to one of the rear pads (D11-D15 =
# GPIO 38-42) instead, so the instrument is recoverable with a soldering iron.
# Nobody has wanted it enough to do that.
#
# The alternative was D1 = GPIO 2, the LED sync marker, which is enabled in this
# build and is the check that needs no console at all. Keeping a working
# instrument beat keeping a disabled one.
#
# The handshake is the OUTPUT of the four, and it is on D2 = GPIO 3 for that
# reason: 3 is this part's JTAG_SEL strapping pin -- inert unless the
# STRAP_JTAG_SEL eFuse is burned -- and a pin this board drives itself is a
# safer thing to put there than one the bridge is driving while we boot.
CONFIG_DANCEFLOOR_SBC_SPI_SCK_PIN=44
CONFIG_DANCEFLOOR_SBC_SPI_MOSI_PIN=6
CONFIG_DANCEFLOOR_SBC_SPI_CS_PIN=5
CONFIG_DANCEFLOOR_SBC_SPI_HS_PIN=3

# WS2812 data, still via the 74AHCT125 -- the S3 drives 3.3 V exactly as the
# classic ESP32 does, so the level shifter is no less necessary here. Driven
# through SPI2_HOST and the GPIO matrix, which is fine at the ~2.4 MHz the
# WS2812 encoding needs. Never RMT: see architecture.md S12.
CONFIG_DANCEFLOOR_LED_GPIO=1

# gpio_set_level() into IRAM, for the SBC link's handshake.
#
# The two spi_slave callbacks that raise and drop the handshake are IRAM_ATTR
# because they run in interrupt context, and without this that attribute is
# decoration: the callback is in IRAM and the one function it calls is not.
# IDF defaults this off and the cost is a few hundred bytes of IRAM.
#
# It does not make the handshake work with the flash cache disabled -- the
# spi_slave ISR is registered without ESP_INTR_FLAG_IRAM, so a flash write
# defers the interrupt rather than taking it, and the handshake drops late. That
# is the bridge's 100 ms timeout's problem, and it counts what it refuses.
CONFIG_GPIO_CTRL_FUNC_IN_IRAM=y

# The LED sync marker, on D1 = GPIO 2, which the Kconfig already defaults to.
#
# Tracked here rather than left to menuconfig because it was ON in this board's
# untracked sdkconfig and was lost the moment that file was regenerated -- the
# same way the "boom" pattern below was lost, for the same reason, and this file
# already carries a paragraph about that. A bench instrument nobody can find the
# switch for is one nobody uses.
#
# It also earned its place in the pin argument above: the four SPI pads were
# chosen to keep this working, and a setting that decided a pin allocation
# should not live somewhere a rebuild can drop it.
CONFIG_DANCEFLOOR_ENABLE_LED_MARKER=y

# The bench marker pins are NOT set here, on purpose.
#
# DANCEFLOOR_MARKER_GPIO and DANCEFLOOR_MONITOR_GPIO both depend on
# DANCEFLOOR_ENABLE_MARKER, which is off, so they are invisible when this file
# is applied and any value given for them here is silently discarded. Enabling
# the marker later would then fall back to the Kconfig defaults -- and the
# classic hub's monitor pin, 21, is this board's onboard LED rather than a pad.
#
# The marker stays at 4 (D3), which is the one number that survived the move.
# The monitor default is 5 (D4), set in main/Kconfig.projbuild where it cannot
# be dropped.
#
# DANCEFLOOR_LED_MARKER_GPIO lives in the shared components/dancefloor_leds/
# Kconfig and needs nothing here either. Its default is 2, which on this board
# is pad D1 -- free, not a strapping pin, and in range. Wire an LED from 3V3
# through a 330 R resistor to that pad; the pin sinks it to light it.
#
# DANCEFLOOR_LED_MARKER_ACTIVE_LOW is what makes that wiring correct rather than
# inverted, and it defaults to y in the shared Kconfig, so it needs nothing here
# either. It is named here only because the failure is deceptive: wrong setting
# means lit for the 960 ms between flashes and dark for the flash, which reads
# as a sync fault beside a correctly wired unit rather than as a wiring error.
#
# Do NOT point it at 21. Seeed documents it as the onboard user LED on every
# variant in the series and this file used to recommend it; it has since been
# seen not to light at all, and the reason was never confirmed -- the LED may
# simply not be on 21 on every board revision. (The other suspect, that the
# Sense's SD slot used 21 for CS, dies with the move to a Plus, which has no card
# reader. The LED still did not light.) Its being active low used to be a second
# reason to avoid it and no longer is. An external LED on D1 avoids the question
# entirely.

# ---------------------------------------------------------------------------
# Carried over, but NOT carried over on evidence
# ---------------------------------------------------------------------------
#
# Keep the lwIP tcpip thread off the core the LED tasks run on.
#
# On the classic hub this was the whole fix for render starvation: wake overshoot
# mean 2057 -> 634 us, pattern arithmetic max 23226 -> 5254 us, late frames
# 10 -> 0. Both parts of that reasoning still hold in principle -- the thread
# still runs at priority 18, above every task this firmware creates, core locking
# is still off so every sendto() blocks in that thread rather than in the caller,
# and this unit still drives ~30x the priority-18 work a satellite does.
#
# What does NOT carry over is the measurement. Those numbers were taken on a
# 240 MHz LX6 with esp-dsp's generic FFT; this is an LX7 with the SIMD path, and
# the starvation may be smaller, absent, or differently shaped. It is set here
# because it was right there and is unlikely to hurt, which is exactly the
# standard architecture.md's postscript says produced most of the wasted effort
# in this project.
#
# Before trusting it, run it both ways and read the vis log line. That is a
# measurement nobody has made on this part.
CONFIG_LWIP_TCPIP_TASK_AFFINITY_CPU0=y

# ---------------------------------------------------------------------------
# Deliberately NOT set
# ---------------------------------------------------------------------------
#
# PSRAM. Still not used for anything by default -- see the note below the
# switches, which is the one that matters.
#
# The old note here said "turn it on only with a specific allocation in mind".
# There is now exactly one: a TFLM tensor arena, which is the one buffer in this
# project that is large, touched only by a low-priority task on the other core,
# and useless to shrink. Everything that note refused is still refused.
#
# It is NOT for the ring. PSRAM is the wrong memory for a ring regardless, since
# the ring is touched from the playback path and cache misses there are the one
# thing that loop cannot absorb.
#
# It is NOT for the lead. The ring that bounds LEAD + RESYNC is the SATELLITE's,
# and the satellite is a classic ESP32 with no PSRAM at all -- so no amount of
# memory on this unit buys the lead a single millisecond. That is the whole
# answer to "the S3 has plenty of PSRAM, can we not have a 500 ms lead": a 500 ms
# lead needs ~107 kB of satellite ring against a largest free block of 106 kB,
# and it would fail to allocate on the board that has to hold it.
#
# The larger ring the wart actually wanted has since been taken, in the
# satellite's internal SRAM, where it belongs: 64 -> 80 kB, which moved the
# bound from 320 ms against 372 to 350 against 464 and let RESYNC_US go from
# 120 to 150.
#
# The octal interface eats GPIO 33-37. On the Sense this cost nothing at all --
# those pins are not broken out anywhere on that board. On the Plus it MAY cost
# something: the extra rear pads are around nine GPIOs, of which 38-42 are the
# confirmed ones, and whether 33-37 are among the rest has not been checked
# against the schematic. It is still free as this build stands, because nothing
# here uses a rear pad; check before designing anything that does.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y

# THE line, and the reason enabling PSRAM at all is safe here.
#
# CAPS_ALLOC means ordinary malloc() NEVER returns PSRAM. The ring, the DMA
# buffers, the frame queue and every stack stay exactly where they are, in
# internal SRAM, with exactly the timing they were measured with. PSRAM is
# reachable only by asking for it by name -- heap_caps_malloc(n,
# MALLOC_CAP_SPIRAM), which in this tree is ml_arena.c and nothing else -- or
# via the one narrow exemption below, which moves WiFi and lwIP only.
#
# This paragraph used to say the WiFi buffers stayed internal too. They do not
# any more, and the measurement that changed it is recorded below.
#
# The alternative, SPIRAM_USE_MALLOC, would let the allocator hand PSRAM to
# anything above a threshold, which is precisely the "adds cache-miss jitter to
# every task" the old note warned about. That warning was right and this setting
# is how it is respected rather than overruled.
CONFIG_SPIRAM_USE_CAPS_ALLOC=y

# Read the vis `cost:` line and the HEALTH heap figures after flipping this on,
# and compare against the numbers recorded above: analysis 3900/21000 us
# mean/max, hub min heap ~68 kB, 0 audio gaps/min over 18 min. The old note
# asked for exactly this measurement and recorded that nobody had made it on
# this part. It is still worth making -- enabling the PSRAM controller changes
# cache behaviour even when nothing allocates from it.
#
# UPDATE: the `hub min heap ~68 kB` in that paragraph is a CLASSIC-HUB figure
# and cannot be compared against this board. On the classic ESP32 there was one
# pool, so esp_get_free_heap_size() was the internal figure. Turning PSRAM on
# here silently moved that field to an 8 MB pool nothing on the audio path can
# use, and no internal figure replaced it until the MEM line existed. The first
# real internal baseline on this part, taken with that line:
#
#   MEM: internal 22056 free (min 5808, window 20676, largest 11776)
#   MEM: internal 21912 free (min 1520, window 20512, largest 11776)
#
# 1520 bytes. The hub had been running that close to the floor for as long as
# PSRAM has been on, and every figure on HEALTH said 8 MB free.

# The narrow exemption: WiFi and lwIP allocate from PSRAM first, internal second.
#
# WHY. The registered internal heap on this part is ~268 kB, not the 512 kB the
# datasheet headline suggests -- ~102 kB is DRAM shadowed by IRAM code
# (.dram0.dummy), ~96 kB is static .data/.bss, ~33 kB is ROM-reserved. Of that
# ~268 kB, ~246 kB is live: ~53 kB of task stacks and ~122 kB of this app's own
# buffers (local_ring 64 kB, the visualiser's pcm_stream 32.8 kB, the ML lane
# 12.8 kB, I2S DMA 6 kB, SPI frames 4.1 kB). What is left has to absorb WiFi's
# 32 dynamic TX and 32 dynamic RX buffers, whose transient ceiling is ~105 kB.
# It cannot, and the 1520-byte watermark above is the collision.
#
# The failure was caught in the act:
#
#   E ALLOCATION FAILED 2 time(s): largest request 1700 B (caps 0x1800 INTERNAL)
#
# and the chain to those caps is exact. With this symbol off, wifi_malloc() is
# plain malloc() (esp_wifi/esp32s3/esp_adapter.c), and heap_caps_malloc_default()
# ANDs in MALLOC_CAP_INTERNAL because CAPS_ALLOC leaves malloc_alwaysinternal_
# limit at MALLOC_DISABLE_EXTERNAL_ALLOCS -- giving DEFAULT|INTERNAL = 0x1800,
# the caps in the log. The 1700 bytes is one dynamic TX buffer.
#
# WHAT MOVES, AND WHAT DOES NOT. Only WiFi and lwIP. wifi_malloc() becomes
# heap_caps_malloc_prefer(size, 2, DEFAULT|SPIRAM, DEFAULT|INTERNAL) -- PSRAM
# first, internal fallback RETAINED, so nothing that succeeds today can start
# failing. The audio ring, the I2S DMA buffers, the frame queue and every task
# stack are untouched: the playback loop, which is the one thing that cannot
# absorb cache-miss jitter, never sees PSRAM. WiFi is both the pool that spikes
# and the one furthest from that loop, which is what makes it the right thing to
# move and the ring the wrong thing.
#
# RISK, and how to falsify it: WiFi buffers now sit behind the PSRAM cache. Read
# the vis `cost:` mean/max, `sbc_in ... max gap`, and tx-fail against a capture
# from the previous flash on the same track. If any of them move, this comes out
# -- the diagnostic half of this branch stands on its own.
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y

# The three below are PINNED AT THEIR CURRENT VALUES, not tuned. Enabling the
# symbol above would otherwise move all three, and this has to stay a single-
# variable experiment for the same reason the TX buffer count was returned to 32
# further up: the only question being asked here is WHERE WiFi memory comes
# from, and an answer confounded by three other changes is not an answer.
#
# STATIC_RX_BUFFER_NUM would go 10 -> 16, RX_BA_WIN 6 -> 16 (both in
# esp_wifi/Kconfig, defaulted per SPIRAM_TRY_ALLOCATE_WIFI_LWIP). The BA window
# matters on the air, not just in RAM: the satellite is built with 6, and moving
# only this end changes what the two negotiate.
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=10
CONFIG_ESP_WIFI_RX_BA_WIN=6

# CACHE_TX_BUFFER_NUM only exists when the symbol above is set, and defaults to
# 32. It queues upper-layer packets in PSRAM when no static TX buffer is free,
# instead of rejecting them.
#
# WAS 0 DELIBERATELY, on two objections. "Worth trying on its own once the
# fan-out work needs it" is what the note said, and the fan-out work needs it.
#
# The first objection does not survive being checked. "A late audio packet is
# refused at anchor time anyway (ANCHOR_MIN_LEAD_US)" -- but that gate applies
# at STREAM START, not to packets inside a running stream, and the hub stamps
# play_at 200 ms ahead. A packet held a few ms in this queue still arrives with
# ~195 ms of lead and plays normally. The alternative is not a late packet, it
# is no packet: a hole in the sound on every satellite at once, recoverable from
# the FEC only if the NEXT packet gets through, which under a burst of ENOMEM is
# exactly what does not happen.
#
# The second objection stands, and is why this is BACK AT 0 after one run with
# it on: it converts tx-fail into silence, and tx-fail is the counter this whole
# file is written around.
#
# The run with it on (17:52) is the useful negative result. tx-fail did NOT go
# away -- 10 to 58 audio rejections per 20 s window with 32 cache buffers in
# front of them -- which says the constraint is AIRTIME, not buffer count. A
# queue cannot make a stream fit that does not fit; it only delays the moment it
# does not. So the queue was never going to be the fix, and leaving it on now
# would confound the thing that might be: with FEC at 0 an audio packet drops
# from the 1472-byte MTU back to ~851 B, and the question is whether tx-fail
# goes to zero because of that. It cannot be answered through a queue that
# absorbs the evidence either way.
#
# Turn it back on once tx-fail is genuinely 0 and the reason is understood. It
# is free in the pool that matters -- these live in PSRAM, of which the hub has
# 8 MB, while the static buffers are internal SRAM with ~6.7 kB free and a
# largest block of 3584, room for two more of those at most -- so it is worth
# having as burst insurance. It is not worth having as a blindfold.
CONFIG_ESP_WIFI_CACHE_TX_BUFFER_NUM=0

# Forward this unit's logs and HEALTH snapshots over the sync socket to a
# laptop collector (see CONFIG_DANCEFLOOR_WIFI_LOGS). Bench only, and now OFF by
# default -- which is what the line above always said and what this setting
# contradicted. The Kconfig default is n; these two files were the only thing
# turning it on.
#
# Off because it is not free on the resource this hub is short of. Every
# ESP_LOG line becomes a datagram, and the hub relays every satellite's as well,
# so it is bursty unicast traffic drawn from the same static TX buffer pool that
# the audio and the analysis frames are competing for -- and a burst of log
# lines is exactly what a fault produces, so the instrument gets loudest at the
# moment it can least afford to. The satellite's own Kconfig help records the
# sharper version of this: a blocking log write in the receive path "starves the
# UDP mailbox and causes the very loss it was logging".
#
# WHAT TURNING IT OFF COSTS: tools/log_collector/collect.py stops working, and a
# satellite's log is then only readable on that satellite's own serial port.
# Turn it back on -- here and on every satellite, they must agree -- for any run
# where centralised capture is worth the airtime. It compiles out entirely when
# unset: no shipper task, no queue, no wifi_log symbols.
CONFIG_DANCEFLOOR_WIFI_LOGS=n

# How many DHCP leases the SoftAP can hand out. IDF's default is 8, which was
# invisible while MAX_CLIENTS was also 8: it agreed by coincidence rather than
# by construction, and nothing named it.
#
# It is the THIRD of three limits that decide how many satellites a floor can
# hold, and the only one whose failure is quiet. The other two -- MAX_CLIENTS
# and wifi_config.ap.max_connection -- refuse a satellite at association, which
# it notices and reports. Running out of leases lets it associate and then gives
# it no address, so the hub sees a station that joined and never probed, and
# n_sta_nolease is the only tell. Kept at MAX_CLIENTS so the three move
# together.
CONFIG_LWIP_DHCPS_MAX_STATION_NUM=15

# THE HUB RUNS NO PLUGGABLE ANALYSERS. The setting that says so is now
# DANCEFLOOR_ML, which replaced the DANCEFLOOR_ML_SOURCE choice when results
# stopped being distributed; DANCEFLOOR_PUBLISH_ML went at the same time.
#
# Pinned here rather than left to the Kconfig default of n, for the reason the
# old ML_SOURCE line was pinned: sdkconfig is gitignored, this hub's measurements
# were all taken with the lane off, and a clone that quietly turned it on would
# invalidate them. The default agrees today -- that is not a reason to rely on it.
#
# What it cost the hub when the choice existed: nothing it was using. The lane's
# two analysers are ZcrRms and Mood; the periodic log read `slow 0/0 us` and
# `results N+0` for the whole of every run captured -- the slow lane produced
# nothing at all -- and `ml-throt` showed ~77 of the fast one's results a second
# being computed and thrown away against a 100 ms publish period.
#
# What it bought: ~25 kB of INTERNAL SRAM, the pool the WiFi static TX buffers
# come from and the binding constraint on this board. The lane's stream buffer
# alone was 12.8 kB (16 kHz x 400 ms x 2 B), plus a 4 kB mlan stack and its TCB,
# plus ~6.3 kB of resampler table and decimation buffer. None of it could live in
# PSRAM: SPIRAM_USE_CAPS_ALLOC means plain malloc and every task stack are
# internal.
#
# The lane is on its way out entirely: once the analysers read the quantised
# spectrum every unit already receives in MSG_FRAME, they need no audio, no
# resampler and no task, which is what makes running them on a satellite
# practical. Until then this line is what keeps them off here.
CONFIG_DANCEFLOOR_ML=n

# MEASURED, AND IT WORKS AT 32 BUFFERS. Overrides the Kconfig default of n,
# which stays n because it is the right answer for a hub with the 26 static TX
# buffers that default implies. This one has 32, which is the whole point of the
# two settings above -- they belong together and neither is safe alone.
#
# The question was narrow: does a 32-buffer pool absorb a DTIM burst of ~15
# group frames, where 26 could not? It does. The run:
#
#   hub  tx-fail 0 (0 audio) | cong-skip 0 | 50 pkts/s | frames mcast
#   sat  gaps 0 (0 short, 0 too big) ring-full 0        -- at 65 s AND 125 s
#   sat  leds remote hop 512 (rx 5012 -> 10181, bad 0)  -- 86.1 frames/s, none bad
#
# Zero audio gaps across the whole run, against 8 in 545 s on the unicast-frames
# build and 0.17/s when this branch started. The strips get every frame.
#
# What it buys is the only thing that makes the hub's transmit rate FLAT in
# speaker count: 50 + 96xN packets/s becomes ~146, whatever N is. At fifteen
# satellites that is ~316/s against ~1490/s, and only the probe traffic still
# scales.
#
# If this is ever turned on WITHOUT the 32 buffers it reproduces the failure it
# came from -- `tx-fail 14-27 audio` per 20 s and the satellite's gap rate
# tracking it one for one at 1.1/s. The burst, not the average, is what empties
# the pool, so the two settings move together or not at all.
#
# STILL ONLY MEASURED AT TWO SATELLITES. The arithmetic says the frames stop
# scaling; nothing has put more than two on the floor to check it, and the
# probe traffic that does still scale has never been measured past two either.
CONFIG_DANCEFLOOR_MCAST_FRAMES=y
