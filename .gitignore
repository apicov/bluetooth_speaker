# ESP-IDF build output
build/
sdkconfig
sdkconfig.old

# A second target built side by side, which is how satellite/ is checked for
# both the classic ESP32 and the S3 without one clobbering the other's config:
#
#   idf.py -B build.s3 -DIDF_TARGET=esp32s3 -DSDKCONFIG=sdkconfig.s3 build
#
# sdkconfig.defaults and sdkconfig.defaults.<target> are the tracked inputs and
# are deliberately NOT matched here -- only the generated per-target output is.
build.*/
sdkconfig.s3

# Fetched by the component manager from idf_component.yml
managed_components/
dependencies.lock

# Host test binaries and their intermediates
components/dancefloor_sync/test/test_sync_proto
components/dancefloor_sync/test/test_audio_shift
components/dancefloor_leds/test/test_align
components/dancefloor_leds/test/test_pattern
components/dancefloor_leds/test/test_beat_detect
components/dancefloor_leds/test/test_fft
components/dancefloor_leds/test/test_pattern_sync
components/dancefloor_leds/test/test_result_latch
components/dancefloor_leds/test/test_resample
components/dancefloor_leds/test/*.o

# Python bytecode from running tools/
__pycache__/

# clangd's index, one per project because each has its own compile_commands.json.
# Regenerated from the build on demand and machine-specific, so there is nothing
# in it another checkout could use.
.cache/

# A separate project, kept here for reference: components/led_strip_wrapper is
# vendored from it. It has its own git repository, so it must not be committed
# into this one -- a nested repo would go in as an unusable gitlink.
esp32c3_neopixel/

# The desktop client moved to its own repository (../dancefloor-tools) and is
# built against nothing here. Ignored in case a checkout is dropped alongside,
# for the same nested-repo reason as above.
dancefloor-tools/
tools/desktop_satellite.py

# Host tool build output
tools/pattern_lab/pattern_lab
tools/pattern_lab/*.o
tools/tuning/converge
tools/tuning/*.o

# Bench captures from tools/log_collector/collect.py -- one session directory
# per run, holding that run's all.jsonl and health.csv.
tools/log_collector/logs-*/
logs-*/
