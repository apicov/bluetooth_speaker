CONFIG_FREERTOS_HZ=1000
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y

# esp_wifi_internal_set_fix_rate() returns ESP_ERR_NOT_SUPPORTED while TX AMPDU
# is enabled, and pinning the multicast rate is required for throughput.
CONFIG_ESP_WIFI_AMPDU_TX_ENABLED=n

# 50% overlap between analysis windows. The window stays 1024; this is only how
# far the analysis advances between them, so it doubles the frame rate to 86 Hz
# without changing the FFT's resolution.
#
# Stated here as well as being the Kconfig default because it is the hop the
# detector is tuned at. Both flux floors and the beat history were swept against
# 206 recordings at 512 and none of the three moved, so a floor running this is
# running the tuned detector -- see docs/tuning-corpus.md. Kept in the tracked
# config rather than left to the component default because a hop mismatch across
# a floor is the expensive bug.
CONFIG_DANCEFLOOR_LED_HOP_512=y

# The pattern the floor runs, which is a floor-wide agreement and not a per-unit
# preference: two units on different patterns are not comparable by eye, and the
# eye is the only instrument most of this project has.
#
# Pinned here for the same reason the hop above is. The Kconfig default is
# "pulse"; this floor runs "boom"; sdkconfig is gitignored, so this line is the
# only place the floor's choice survives a fresh checkout. It did not survive
# one: hub_s3 was built without it and came up cycling a 28-second hue against
# its neighbours' fixed amber, which reads as a sync fault rather than as a
# config difference.
CONFIG_DANCEFLOOR_LED_PATTERN="boom"

# Keep the lwIP tcpip thread off the core the LED tasks run on.
#
# It runs at priority 18 -- above every task this firmware creates -- and IDF
# leaves it unpinned by default. Core locking is off (CONFIG_LWIP_TCPIP_CORE_LOCKING
# is not set), so every sendto() posts to that thread and blocks; the work is done
# there, not in the caller. This unit drives ~43 audio sends/s plus 86 analysis
# frame sends/s at one satellite, against the satellite's 4 probes/s -- so ~30x
# the priority-18 work, on a core that also carries play, vis-draw and vis.
#
# That is the suspect for the hub's render starvation: wake overshoot mean 2057 us
# and max 26037, against the satellite's 500/8789, with pattern arithmetic over
# eight pixels reaching 23 ms against a 96 us mean. Nothing in that loop varies
# 200x; it is being suspended part-way through.
#
# Pinned to CPU0 rather than CPU1 because that is where the WiFi task already is,
# and because CPU1 is the core being cleared. Set on the hub only: the satellite
# is the control this is measured against and its config is deliberately left
# alone.
CONFIG_LWIP_TCPIP_TASK_AFFINITY_CPU0=y
