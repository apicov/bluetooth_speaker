CONFIG_BT_ENABLED=y
CONFIG_BTDM_CTRL_MODE_BR_EDR_ONLY=y
CONFIG_BT_BLUEDROID_ENABLED=y
CONFIG_BT_CLASSIC_ENABLED=y
CONFIG_BT_A2DP_ENABLE=y
CONFIG_DAC_DMA_AUTO_16BIT_ALIGN=n

# Name the phone sees when pairing.
CONFIG_BRIDGE_BT_DEVICE_NAME="Dancefloor"

# BT stack alone is ~950 kB; the stock 1 MB factory partition leaves 10% free.
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# NOTE: do NOT set CONFIG_BT_ACL_CONNECTIONS=1 here. It was added during the
# single-chip memory crisis and it sizes Bluedroid's ACL buffer pools -- with it
# the link stays active but audio trickles in at a few percent of the rate, so
# the sink ringbuffer underflows continuously. This chip has ~63 kB DRAM spare;
# there is nothing to gain.

# No WiFi on this chip at all -- that is the entire point of the split. With
# Bluedroid alone there is ~200 kB of DRAM spare instead of 164 bytes.

# Forward undecoded SBC to the hub instead of decoding here -- the bridge never
# decodes, the hub and the satellites do.
#
# This is not optional and there is no code path for the other setting: with it
# unset Bluedroid decodes SBC itself and the audio data callback in main.c stops
# being fed, so the hub goes silent with nothing failing loudly. It used to be
# selected by a project Kconfig option that offered an internal-codec build; that
# build could never work here (its I2S data pin is the SPI handshake line, GPIO
# 25) and it was removed, so the stack option is set directly.
CONFIG_BT_A2DP_USE_EXTERNAL_CODEC=y
